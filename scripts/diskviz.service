[Unit]
Description=diskviz disk analyzer
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/diskviz/env
ExecStart=/opt/diskviz/bin/diskviz-serve
Restart=on-failure
RestartSec=3
# Run as root so the scanner can stat system directories; restrict via tokens.
User=root

[Install]
WantedBy=multi-user.target
